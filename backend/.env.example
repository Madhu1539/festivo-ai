# ---------------------------------------------------------------------------
# Festivo AI backend environment (§19.1 — never commit a filled-in .env)
# Copy to .env and fill in the values.
# ---------------------------------------------------------------------------

# --- GenAI provider: Gemini (required for plan generation) -----------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any model supporting structured output, e.g. gemini-2.5-flash, gemini-3.5-flash
GEMINI_MODEL=gemini-2.5-flash

# --- Database: Supabase Postgres via the connection pooler -----------------
# Supabase dashboard -> Project Settings -> Database -> Connection pooling.
# Paste the string as-is; the bare postgresql:// scheme is rewritten to
# psycopg 3 automatically, and pooler-specific settings are applied by host/port.
#
# Two things to get right yourself:
#   1. The username must be tenant-qualified: postgres.<project-ref>
#      (a bare "postgres" fails with "password authentication failed")
#   2. URL-encode the password if it contains @ : / ? # [ ] ! etc.
#
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Leave as-is to use a local SQLite file instead (plans still generate and save).
DATABASE_URL=sqlite:///./festivo.db

# --- App -------------------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Optional tuning (§19.5 cost controls) ---------------------------------
# AI_TIMEOUT_SECONDS=90
# AI_TEMPERATURE=0.8
# AI_MAX_REPAIR_ATTEMPTS=1
# GEMINI_THINKING_BUDGET=0
# DB_ECHO=false
