# Optional. The dev server proxies /api to the backend, so this is usually unset.
# Set it only when the backend runs somewhere else (e.g. a deployed URL).
# VITE_API_BASE_URL=https://your-backend.example.com/api

# Optional. Overrides the dev proxy target (default http://127.0.0.1:8000).
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
